datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ATASAN
  PEGAWAI
}

enum AttendanceStatus {
  TEPAT_WAKTU
  TERLAMBAT
  DINAS_LUAR
}

enum ClockOutStatus {
  NORMAL
  PULANG_CEPAT
  DINAS_LUAR
}

enum LeaveType {
  CUTI_TAHUNAN
  IZIN
  SAKIT
  CUTI_MELAHIRKAN
  LAINNYA
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CampusLocation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  code         String?
  address      String
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(100.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedUsers User[]       @relation("UserAssignedLocation")
  attendances   Attendance[] @relation("LocationAttendances")

  @@map("campus_locations")
}

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  nip                String          @unique
  name               String
  email              String?
  password           String
  role               Role            @default(PEGAWAI)
  jabatan            String
  unitKerja          String
  atasanId           String?         @db.ObjectId
  atasan             User?           @relation("UserHierarchy", fields: [atasanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bawahan            User[]          @relation("UserHierarchy")
  
  assignedLocationId String?         @db.ObjectId
  assignedLocation   CampusLocation? @relation("UserAssignedLocation", fields: [assignedLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  isActive           Boolean         @default(true)
  avatarUrl          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]  @relation("UserLeaves")
  approvedLeaves LeaveRequest[]  @relation("ApproverLeaves")
  dutyTrips      DutyTrip[]      @relation("UserDutyTrips")
  approvedTrips  DutyTrip[]      @relation("ApproverDutyTrips")
  campusSettings CampusSetting[]

  @@map("users")
}

model Attendance {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  userId           String            @db.ObjectId
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  
  // Lokasi Gedung Presensi
  locationId       String?           @db.ObjectId
  location         CampusLocation?   @relation("LocationAttendances", fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationName     String?

  // Masuk (Clock-in)
  clockInTime      DateTime?
  clockInLat       Float?
  clockInLng       Float?
  clockInPhoto     String?
  clockInDistance  Float?
  clockInStatus    AttendanceStatus?
  clockInNote      String?

  // Pulang (Clock-out)
  clockOutTime     DateTime?
  clockOutLat      Float?
  clockOutLng      Float?
  clockOutPhoto    String?
  clockOutDistance Float?
  clockOutStatus   ClockOutStatus?
  clockOutNote     String?

  isDinasLuar      Boolean           @default(false)
  dutyTripId       String?           @db.ObjectId
  dutyTrip         DutyTrip?         @relation(fields: [dutyTripId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendances")
}

model LeaveRequest {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  userId        String        @db.ObjectId
  user          User          @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  attachmentUrl String?
  status        RequestStatus @default(PENDING)

  approverId    String?       @db.ObjectId
  approver      User?         @relation("ApproverLeaves", fields: [approverId], references: [id])
  approverNote  String?
  approvedAt    DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("leave_requests")
}

model DutyTrip {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  userId              String        @db.ObjectId
  user                User          @relation("UserDutyTrips", fields: [userId], references: [id], onDelete: Cascade)
  title               String
  destination         String
  startDate           DateTime
  endDate             DateTime
  letterNumber        String?
  letterAttachmentUrl String?
  status              RequestStatus @default(PENDING)

  approverId          String?       @db.ObjectId
  approver            User?         @relation("ApproverDutyTrips", fields: [approverId], references: [id])
  approverNote        String?
  approvedAt          DateTime?

  attendances         Attendance[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("duty_trips")
}

model CampusSetting {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  campusName         String   @default("STIMI")
  address            String   @default("Kampus STIMI")
  latitude           Float    @default(-3.3186)
  longitude          Float    @default(114.5944)
  radiusMeters       Float    @default(100.0)
  workStart          String   @default("08:00")
  workEnd            String   @default("16:30")
  gracePeriodMinutes Int      @default(15)
  
  updatedById        String?  @db.ObjectId
  updatedBy          User?    @relation(fields: [updatedById], references: [id])
  updatedAt          DateTime @updatedAt

  @@map("campus_settings")
}
