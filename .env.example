# ==========================================
# Database MongoDB Connection URL (MongoDB Atlas)
# ==========================================
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/presensistimi?retryWrites=true&w=majority"

# ==========================================
# NextAuth / Auth.js (Production URL & Secret)
# ==========================================
# Untuk Production Server:
NEXTAUTH_URL="https://presensi.stimiapps.my.id"
# Untuk Local Development:
# NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="presensistimi-secret-key-32-chars-long-secure-token"

# ==========================================
# Default Campus Configuration (STIMI Makassar)
# ==========================================
NEXT_PUBLIC_CAMPUS_NAME="STIMI Makassar"
DEFAULT_CAMPUS_LAT="-5.147665"
DEFAULT_CAMPUS_LNG="119.432732"
DEFAULT_CAMPUS_RADIUS="100"

# ==========================================
# Hybrid Storage (Supabase Cloud + Local Fallback)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="presensistimi"
